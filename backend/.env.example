# DevisPro CI — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs

PORT=3000
FRONTEND_URL=https://devispro-ci.netlify.app

# PostgreSQL (Render ou autre)
DATABASE_URL=postgresql://user:password@host:5432/devispro

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_key

# Mistral AI
MISTRAL_API_KEY=your_mistral_api_key_here

# Brevo — envoi du devis par email (OPTIONNEL)
# Si BREVO_API_KEY est absente, la fonctionnalité "Envoyer par mail" est simplement
# désactivée (HTTP 503) sans empêcher le serveur de démarrer.
BREVO_API_KEY=your_brevo_transactional_api_key
BREVO_SENDER_EMAIL=devis@ton-domaine.ci        # adresse expéditeur vérifiée dans Brevo
BREVO_SENDER_NAME=DevisPro CI                   # optionnel, défaut : "DevisPro CI"

# Wave CI (optionnel MVP)
WAVE_API_KEY=your_wave_api_key_here
WAVE_MERCHANT_ID=your_merchant_id
